generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// Identity lives in Neon Auth (`neon_auth.user`), not here. That table is
// managed by Neon and must never be touched by `prisma db push`, so it is not
// modelled in this schema and no foreign key points at it.
//
// Every profile below carries `userId` — the `neon_auth.user.id` uuid — plus a
// denormalised copy of the name/email so queue lists and dashboards can render
// without a cross-schema join. `lib/auth/profile.ts` keeps the copies in sync
// on each sign-in. Roles live on `neon_auth.user.role`.

model Hospital {
  id        String    @id @default(cuid())
  name      String
  address   String
  city      String
  timezone  String    @default("Asia/Kolkata")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  departments Department[]
  admins      Admin[]
}

model Department {
  id                     String  @id @default(cuid())
  hospitalId             String
  name                   String
  code                   String
  description            String?
  avgConsultDurationMins Int     @default(15)
  isActive               Boolean @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  hospital     Hospital      @relation(fields: [hospitalId], references: [id])
  doctors      Doctor[]
  appointments Appointment[]

  @@unique([hospitalId, code])
  @@index([hospitalId])
}

model Doctor {
  id             String  @id @default(cuid())
  userId         String  @unique // neon_auth.user.id
  name           String
  email          String
  phone          String?
  departmentId   String
  specialization String
  licenseNumber  String  @unique
  isAvailable    Boolean @default(true)
  avgConsultMins Float   @default(15.0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  department       Department        @relation(fields: [departmentId], references: [id])
  appointments     Appointment[]
  consultationLogs ConsultationLog[]

  @@index([departmentId])
  @@index([email])
}

model Patient {
  id               String    @id @default(cuid())
  userId           String    @unique // neon_auth.user.id
  name             String
  email            String
  phone            String?
  dateOfBirth      DateTime?
  bloodGroup       String?
  allergies        String[]
  emergencyContact String?
  familyGroupId    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  appointments Appointment[]
  familyGroup FamilyGroup? @relation(fields: [familyGroupId], references: [id])

  @@index([familyGroupId])
  @@index([email])
}

model FamilyGroup {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  patients  Patient[]
}

model Admin {
  id         String   @id @default(cuid())
  userId     String   @unique // neon_auth.user.id
  name       String
  email      String
  phone      String?
  hospitalId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id])

  @@index([email])
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String
  doctorId        String
  departmentId    String
  tokenNumber     Int
  scheduledAt     DateTime
  status          AppointmentStatus @default(BOOKED)
  appointmentType AppointmentType   @default(FIRST_CONSULTATION)
  notes           String?
  isEmergency     Boolean           @default(false)
  noShowRisk      Float?
  familyGroupId   String?
  checkedInAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  patient    Patient          @relation(fields: [patientId], references: [id])
  doctor     Doctor           @relation(fields: [doctorId], references: [id])
  department Department       @relation(fields: [departmentId], references: [id])
  queueEntry QueueEntry?
  consultLog ConsultationLog?

  @@index([patientId])
  @@index([doctorId])
  @@index([scheduledAt])
  @@index([status])
}

enum AppointmentStatus {
  BOOKED
  CHECKED_IN
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentType {
  FIRST_CONSULTATION
  FOLLOW_UP
  PRESCRIPTION_REFILL
  DIAGNOSTIC_REVIEW
  EMERGENCY
}

model QueueEntry {
  id                   String   @id @default(cuid())
  appointmentId        String   @unique
  doctorId             String
  position             Int
  estimatedWaitMins    Float
  predictionConfidence Float    @default(0.7)
  virtualWaitingRoom   Boolean  @default(false)
  notifiedAt           DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@index([doctorId, position])
}

model ConsultationLog {
  id            String    @id @default(cuid())
  appointmentId String    @unique
  doctorId      String
  startedAt     DateTime
  endedAt       DateTime?
  durationMins  Float?
  notes         String?
  createdAt     DateTime  @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  doctor      Doctor      @relation(fields: [doctorId], references: [id])

  @@index([doctorId])
}

model WaitTimeHistory {
  id                String          @id @default(cuid())
  doctorId          String
  departmentId      String
  appointmentType   AppointmentType
  actualWaitMins    Float
  predictedWaitMins Float
  queueSizeAtTime   Int
  recordedAt        DateTime        @default(now())

  @@index([doctorId])
  @@index([departmentId])
  @@index([recordedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           // neon_auth.user.id
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

enum NotificationType {
  QUEUE_UPDATE
  APPOINTMENT_REMINDER
  TURN_APPROACHING
  EMERGENCY_OVERRIDE
  SYSTEM
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   // neon_auth.user.id
  action    String
  entity    String
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}
